{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "showjcr-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "showjcr-web"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
